{
  "expo": {
    "name": "NY_APP",
    "slug": "NY_APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mxmxrazer.NY_APP"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "babel": {},
        "assetBundlePatterns": [
          "**/*"
        ]
      },
      "web": {
        "basePath": "/NY_APP"
      }
    },
    "extra": {
      "eas": {
        "projectId": "62af60e5-18b0-48ae-bfca-a8492bd81648"
      }
    }
  }
}